# Public browser configuration. The Supabase anon/publishable key is designed
# to be exposed; authorization must remain in Postgres RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never place the Supabase service-role/secret key in NEXT_PUBLIC_* variables
# or in this application unless a narrowly scoped server-only workflow is
# designed and reviewed for it.
